{
  "name": "jeromy-dsh",
  "version": "0.2.0",
  "description": "jeROMy: AI ROM-hacking agent for NES games in Mesen2, as a DeepSeek Harness (dsh) plugin and bundle",
  "keywords": [
    "rom-hacking",
    "nes",
    "emulator",
    "ai-agent",
    "mesen"
  ],
  "author": "",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoganBresnahan/jeROMy.git"
  },
  "type": "module",
  "main": "dist/dsh/index.js",
  "types": "dist/dsh/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dsh/index.d.ts",
      "default": "./dist/dsh/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "cordis.patch.yml",
    "mappings/*.json",
    "skills/**/SKILL.md",
    "mesen/bridge.lua",
    "capstone/capstone.js",
    "capstone/capstone.wasm",
    "capstone/package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "dependencies": {
    "uuid": "^13.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/schemastery": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-attachment": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.1 <0.3.0"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

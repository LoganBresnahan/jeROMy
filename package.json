{
  "name": "jeromy",
  "version": "0.1.0",
  "description": "AI-powered ROM hacking agent for retro game modding via natural language",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:web": "esbuild src/web/chat.ts --bundle --outfile=dist/web/chat.js --format=esm --target=es2022 && cp src/web/index.html dist/web/index.html",
    "dev": "npm run build:web && tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "rom-hacking",
    "nes",
    "emulator",
    "ai-agent",
    "mesen"
  ],
  "author": "",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.27.3",
    "happy-dom": "^20.7.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "ws": "^8.19.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@signalapp/sqlcipher": "^3.1.0",
    "uuid": "^13.0.0"
  }
}
